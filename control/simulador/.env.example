# Simulador SCADA MQTT - Variables de Entorno (.env.example)
# Copia este archivo a .env y actualiza con tus valores reales

# ═════════════════════════════════════════════════════════════════
# CONFIGURACIÓN MQTT BROKER
# ═════════════════════════════════════════════════════════════════
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=admin
MQTT_PASSWORD=admin
MQTT_KEEPALIVE=60
MQTT_QOS=1

# ═════════════════════════════════════════════════════════════════
# IDENTIDAD DEL SIMULADOR
# ═════════════════════════════════════════════════════════════════
MQTT_TENANT=Rafaela_S.A
MQTT_GATEWAY_ID=sim_gateway_01
MQTT_CLIENT_ID=scada_simulador

# ═════════════════════════════════════════════════════════════════
# CONFIGURACIÓN POR DEFECTO PARA TOPICS
# ═════════════════════════════════════════════════════════════════
MQTT_DEFAULT_SECTOR=A1
MQTT_DEFAULT_SYSTEM=linea_mezclado_1

# ═════════════════════════════════════════════════════════════════
# TOPICS MQTT - LEGACY (OPCIONAL)
# ═════════════════════════════════════════════════════════════════
MQTT_ENABLE_LEGACY_TOPICS=false
MQTT_LEGACY_BASE_TOPIC=scada/planta1

# ═════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DEL SIMULADOR
# ═════════════════════════════════════════════════════════════════
SIM_INTERVAL=2.0
SIM_RUN_MODE=gui            # 'gui' para interfaz gráfica, 'daemon' para consola
SIM_LOG_LEVEL=info

# ═════════════════════════════════════════════════════════════════
# LOGGING Y DEBUG
# ═════════════════════════════════════════════════════════════════
LOG_DIR=logs
LOG_LEVEL=INFO
DEBUG_MODE=false
